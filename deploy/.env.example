# Copy to .env and fill in. Never commit .env.

# --- Domains ---
# Where the bridge API is reachable from withtend.ai (CORS target)
API_DOMAIN=api.withtend.ai
# Where Nango's dashboard lives (used for setting up provider configs)
NANGO_DOMAIN=nango.withtend.ai
# Public URL Nango uses for OAuth callbacks (must match NANGO_DOMAIN with https)
NANGO_PUBLIC_URL=https://nango.withtend.ai

# --- CORS ---
# The origin the bridge accepts requests from. In prod set to withtend.ai.
ALLOW_ORIGIN=https://withtend.ai

# --- Nango secrets ---
# Generate with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=replace-with-32-byte-base64

# Database password for Nango's Postgres
NANGO_DB_PASSWORD=replace-with-strong-password

# Dashboard login (you'll log into nango.withtend.ai with these)
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=replace-with-strong-password

# Nango secret key. Nango prints this in logs on first boot. Paste it
# here, then `docker compose restart bridge`.
NANGO_SECRET_KEY=fill-in-after-first-boot

# --- Hermes agent runtime ---
# Default agent name to load when a tenant doesn't have one mapped yet.
HERMES_AGENT_DEFAULT=main
